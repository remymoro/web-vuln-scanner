# Copier en .env pour le développement local ; ne jamais committer .env.
DATABASE_URL=postgresql+psycopg://scanner:scanner@localhost:5432/scanner
REDIS_URL=redis://localhost:6379/0
SCAN_TIMEOUT_SECONDS=300
# Un scan resté pending plus longtemps est considéré abandonné.
SCAN_PENDING_TIMEOUT_SECONDS=3600
# Délai minimum entre deux scans d'une même cible (429 sinon).
SCAN_COOLDOWN_SECONDS=600
# Au moins 32 caractères. Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_MINUTES=30
