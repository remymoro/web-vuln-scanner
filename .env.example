# Copier en .env et renseigner ces trois secrets avant docker compose up.
# JWT : python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
# Mot de passe compatible avec une URL, par exemple secrets.token_hex(24).
POSTGRES_PASSWORD=
# Clé d'API interne de ZAP : python3 -c 'import secrets; print(secrets.token_hex(24))'
ZAP_API_KEY=
